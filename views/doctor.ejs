<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Our Doctors - Jeevan Raksha Hospital</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>

  <style>
    .doctors-section {
      display: grid;
      grid-template-columns: 1fr;
      gap: 25px;
      width: 90%;
      margin: 70px auto;
      color: white;
    }

    .doctor-card {
      background: #112345;
      border: 1px solid #3a7bff;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 25px;
      display: flex;
      gap: 20px;
      align-items: flex-start;
      min-height: 170px;
    }

    .doctor-img {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      border: 2px solid #3a7bff;
      object-fit: cover;
    }

    .doctor-info {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-width: 300px;
    }

    .doctor-info h3 {
      margin: 5px 0;
      font-size: 22px;
      color: #3a9bff;
      margin-bottom: 4px;
    }

    .doctor-info p {
      margin: 4px 0;
      opacity: 0.9;
      margin-bottom: 4px;
    }

    .btn-book {
    margin-top: 16px;
    background: #3a7bff;
      padding: 8px 14px;
      color: white;
      text-decoration: none;
      border-radius: 5px;
      width: auto;
      min-width: 160px;
      max-width: 250px;
      margin-right: auto;
      display: block;
    }
  </style>
</head>

<body>
<!-- Header -->
  <header class="main-header">
  <div class="logo-section">
    <i class="fas fa-heartbeat logo-icon"></i>
    <h1>Jeevan Raksha</h1>
  </div>
  <nav class="center-nav">
  <a href="/home">Home</a>
  <a href="/about">About</a>
  <a href="/doctors">Doctors</a>
  <a href="#footer">Contact</a>
</nav>
<div class="nav-right">
  <% if (session && session.user) { %>
    <!-- PROFILE DROPDOWN -->
    <div class="profile-dropdown">
      <button class="profile-btn" id="profileBtn">
        <i class="fa fa-user-circle"></i>
        <span><%= session.user.name %></span>
        <i class="fa fa-caret-down"></i>
      </button>

      <div class="dropdown-menu" id="dropdownMenu">
        <a href="/logout">Logout</a>
      </div>
    </div>

  <% } else { %>
    <a href="/login" class="login-btn">Login</a>
  <% } %>
</div>
</header>


  <!-- Doctors Page -->
  <section class="doctors-section">
    <h2 style="color: #3a9bff; margin-top:10px;margin-bottom: 20px;">Our Expert Doctors</h2>

    <% doctors.forEach(doc => { %>
    <div class="doctor-card">
      <img src="https://cdn-icons-png.flaticon.com/512/387/387561.png" class="doctor-img">

      <div class="doctor-info">
        <h3><%= doc.name %></h3>
        <p><strong>Specialization:</strong> <%= doc.specialization %></p>
        <p><strong>Hospital:</strong> <%= doc.hospital %></p>
        <!-- <p><strong>Experience:</strong> <%= doc.experience %> years</p> -->

        <a href="/booking" class="btn-book btn-sm">Book Appointment</a>
      </div>
    </div>
    <% }) %>

  </section>

 
  <!-- Footer Section -->
  <footer id="footer" class="footer">

  <div class="footer-container">

    <!-- About Section -->
    <div class="footer-section about">
      <h3>Jeevan Raksha </h3>
      <p>Delivering trusted, advanced, and compassionate healthcare since 1995.</p>
      <p class="emergency"><b>Emergency Helpline:</b> <span>+91 108 / +91 98765 43210</span></p>
    </div>

    <!-- Quick Links -->
    <div class="footer-section">
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/home">Home</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/doctors">Doctors</a></li>
        <li><a href="#footer">Contact</a></li>
      </ul>
    </div>

    <!-- Patient Services -->
    <div class="footer-section">
      <h4>Patient Services</h4>
      <ul>
        <li><a href="/booking">Book Appointment</a></li>
        <li><a href="/lab-tests">Lab Test Information</a></li>
        <li><a href="/reports">Download Reports</a></li>
        <li><a href="/faq">FAQs</a></li>
      </ul>
    </div>

    <!-- Contact Section -->
    <div class="footer-section">
      <h4>Contact Us</h4>
      <p>📍 21, Health Street, Jaipur, Rajasthan, India</p>
      <p>📞 +91 98765 43210</p>
      <p>✉️ contact@jeevanraksha.in</p>
    </div>

    <!-- Social Section -->
    <div class="footer-section">
      <h4>Follow Us</h4>
    <div class="social-icons">
      <a href="#"><i class="fab fa-facebook"></i></a>
      <a href="#"><i class="fab fa-instagram"></i></a>
      <a href="#"><i class="fab fa-twitter"></i></a>
      <a href="#"><i class="fab fa-linkedin"></i></a>
      <a href="#"><i class="fab fa-youtube"></i></a>
    </div>
    </div>

  </div>
  <div class="footer-bottom">
    <p>© 2025 Jeevan Raksha Hospital • Secure | Smart | Live Health Insights</p>
  </div>

</footer>
<script>
const btn = document.getElementById("profileBtn");
const menu = document.getElementById("dropdownMenu");

// When the profile button is clicked
if (btn) {
  btn.addEventListener("click", function (event) {
    event.stopPropagation();
    menu.style.display =
      menu.style.display === "block" ? "none" : "block";
  });
}

// Close dropdown when clicking anywhere on screen
document.addEventListener("click", function () {
  if (menu) menu.style.display = "none";
});
</script>
</body>
</html>
