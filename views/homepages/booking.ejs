<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Book Appointment – Jeevan Raksha</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    /* ── Page Layout ── */
    .page-wrap { padding: 44px 24px 60px; max-width: 1200px; margin: 0 auto; }
    h2.page-title { color: var(--accent); text-align: center; font-size: 1.85em; margin-bottom: 6px; }
    .page-sub  { text-align: center; color: #8aa0c0; margin-bottom: 36px; font-size: .95em; }

    /* ── Login Gate ── */
    .login-gate { text-align: center; padding: 60px 20px; max-width: 480px; margin: 0 auto; }
    .login-gate i  { font-size: 3.2em; color: var(--accent); margin-bottom: 18px; display: block; }
    .login-gate h3 { color: #e6eef6; margin-bottom: 10px; font-size: 1.4em; }
    .login-gate p  { color: #8aa0c0; margin-bottom: 24px; }
    .btn-login  { display: inline-block; padding: 12px 32px; background: var(--accent); color: white; border-radius: 8px; font-weight: 700; text-decoration: none; margin: 0 6px; }
    .btn-signup { display: inline-block; padding: 12px 32px; border: 2px solid var(--accent); color: var(--accent); border-radius: 8px; font-weight: 700; text-decoration: none; margin: 0 6px; }

    /* ── Step Pills ── */
    .steps { display: flex; justify-content: center; gap: 0; margin-bottom: 38px; }
    .step  { display: flex; align-items: center; gap: 8px; font-size: .88em; color: #8aa0c0; }
    .step .num { width: 28px; height: 28px; border-radius: 50%; border: 2px solid #334e7a; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: .85em; }
    .step.active .num { background: var(--accent); border-color: var(--accent); color: white; }
    .step.active { color: #e6eef6; }
    .step.done .num { background: #4ade80; border-color: #4ade80; color: white; }
    .step-line { width: 48px; height: 2px; background: #334e7a; margin: 0 6px; align-self: center; }
    .step-line.done { background: #4ade80; }

    /* ── Filter Row ── */
    .filter-row { display: flex; gap: 12px; margin-bottom: 26px; flex-wrap: wrap; align-items: center; }
    .filter-row label { color: #e6eef6; font-size: .9em; font-weight: 600; white-space: nowrap; }
    .filter-row select, .filter-row input[type="date"] {
      padding: 9px 14px; border-radius: 8px; border: 1px solid #334e7a;
      background: #0f1724; color: #e6eef6; font-size: .9em;
    }
    .filter-row select:focus, .filter-row input:focus { outline: none; border-color: var(--accent); }

    /* ── Doctor Grid ── */
    .doctor-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 20px; margin-bottom: 36px; }
    .doc-card {
      background: var(--card); border: 2px solid rgba(58,123,255,0.2);
      border-radius: 16px; padding: 22px 20px; cursor: pointer;
      transition: border-color .2s, transform .18s, box-shadow .2s;
      position: relative; overflow: hidden;
    }
    .doc-card::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg,var(--accent),#00c6ff); opacity:0; transition:opacity .2s; }
    .doc-card:hover { border-color: var(--accent); transform: translateY(-3px); box-shadow: 0 8px 28px rgba(58,123,255,0.18); }
    .doc-card:hover::before { opacity:1; }
    .doc-card.selected { border-color: var(--accent); background: rgba(58,123,255,0.07); box-shadow: 0 0 0 3px rgba(58,123,255,0.25); }
    .doc-card.selected::before { opacity:1; }
    .doc-avatar { width: 58px; height: 58px; border-radius: 50%; background: linear-gradient(135deg, #1a3461, #2a5298); display: flex; align-items: center; justify-content: center; font-size: 1.6em; color: var(--accent); margin-bottom: 14px; border: 2px solid rgba(58,123,255,0.3); }
    .doc-name  { font-size: 1.05em; color: #e6eef6; font-weight: 700; margin-bottom: 3px; }
    .doc-spec  { font-size: .82em; color: var(--accent); font-weight: 600; margin-bottom: 4px; }
    .doc-hosp  { font-size: .78em; color: #8aa0c0; margin-bottom: 14px; }
    .doc-hosp i { margin-right: 3px; }

    /* Slot chips inside doctor card */
    .slot-chips { display: flex; flex-wrap: wrap; gap: 7px; }
    .slot-chip {
      padding: 5px 11px; border-radius: 20px; font-size: .78em; font-weight: 600;
      border: 1.5px solid rgba(58,123,255,0.35); color: #c9d8f0; background: rgba(58,123,255,0.08);
      cursor: pointer; transition: all .13s;
    }
    .slot-chip:hover:not(.chip-booked) { background: var(--accent); border-color: var(--accent); color: white; }
    .slot-chip.chip-selected { background: var(--accent); border-color: var(--accent); color: white; box-shadow: 0 0 8px rgba(58,123,255,0.5); }
    .slot-chip.chip-booked { opacity:.4; cursor:not-allowed; text-decoration:line-through; }
    .no-slots { font-size: .82em; color: #8aa0c0; font-style: italic; }

    /* ── Booking Form Panel ── */
    .form-panel {
      background: var(--card); border: 1px solid rgba(58,123,255,0.3);
      border-radius: 16px; padding: 34px; margin-top: 8px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.4);
    }
    .form-panel h3 { color: var(--accent); margin: 0 0 22px 0; font-size: 1.15em; }
    .selected-summary {
      background: rgba(58,123,255,0.08); border: 1px solid rgba(58,123,255,0.25);
      border-radius: 10px; padding: 14px 18px; margin-bottom: 22px;
      display: flex; gap: 24px; flex-wrap: wrap;
    }
    .summary-item { font-size: .88em; color: #e6eef6; }
    .summary-item span { color: var(--accent); font-weight: 700; }
    .form-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .form-row { margin-bottom: 0; }
    .form-row.full { grid-column: 1/-1; }
    .form-row label { display: block; margin-bottom: 5px; font-size: .88em; color: #e6eef6; font-weight: 500; }
    .form-row input, .form-row select, .form-row textarea {
      width: 100%; padding: 10px 13px; border-radius: 8px;
      border: 1px solid #334e7a; background: #0f1724; color: #e6eef6;
      font-size: .9em; box-sizing: border-box;
    }
    .form-row input:focus, .form-row select:focus, .form-row textarea:focus { outline: none; border-color: var(--accent); }
    .btn-submit { background: var(--accent); padding: 13px; border: none; color: white; border-radius: 8px; width: 100%; cursor: pointer; font-size: 1em; font-weight: 700; margin-top: 6px; transition: background .2s; }
    .btn-submit:hover { background: #2a68e6; }
    .btn-submit:disabled { opacity: .5; cursor: not-allowed; }
    .alert { padding: 13px 16px; border-radius: 8px; margin-top: 18px; font-weight: 500; }
    .alert-success { background: rgba(74,222,128,0.1); color: #4ade80; border: 1px solid rgba(74,222,128,0.3); }
    .alert-danger  { background: rgba(248,113,113,0.1); color: #f87171; border: 1px solid rgba(248,113,113,0.3); }
    .dept-badge { display: inline-block; padding: 2px 9px; border-radius: 20px; font-size: .73em; font-weight: 700; background: rgba(167,139,250,0.15); color: #a78bfa; margin-bottom: 10px; }
    .loading-slots { font-size: .8em; color: #8aa0c0; }

    @media(max-width:600px) { .form-grid-2 { grid-template-columns: 1fr; } .steps { flex-wrap: wrap; gap: 8px; } }
  </style>
</head>
<body>

<header class="main-header">
  <div class="logo-section">
    <i class="fas fa-heartbeat logo-icon"></i>
    <h1>Jeevan Raksha</h1>
  </div>
  <nav class="center-nav">
    <a href="/home">Home</a>
    <a href="/about">About</a>
    <a href="/doctors">Doctors</a>
    <a href="#footer">Contact</a>
  </nav>
  <div class="nav-right">
    <% if (session && session.user) { %>
      <div class="profile-dropdown">
        <button class="profile-btn" id="profileBtn">
          <i class="fa fa-user-circle"></i>
          <span><%= session.user.name %></span>
          <i class="fa fa-caret-down"></i>
        </button>
        <div class="dropdown-menu" id="dropdownMenu">
          <% if (session.user.role === 'patient') { %><a href="/patient/dashboard">My Dashboard</a><% } %>
          <a href="/logout">Logout</a>
        </div>
      </div>
    <% } else { %>
      <a href="/login" class="login-btn">Login</a>
    <% } %>
  </div>
</header>

<main class="page-wrap">
  <h2 class="page-title"><i class="fas fa-calendar-plus"></i> Book an Appointment</h2>
  <p class="page-sub">Choose a doctor, pick a date, and select your preferred time slot</p>

  <% if (!session || !session.user) { %>
    <!-- LOGIN GATE -->
    <div class="login-gate">
      <i class="fas fa-lock"></i>
      <h3>Login Required</h3>
      <p>You must be logged in or registered as a patient to book an appointment.</p>
      <a href="/login" class="btn-login">Login</a>
      <a href="/signup" class="btn-signup">Register</a>
    </div>

  <% } else { %>

    <!-- Step indicator -->
    <div class="steps">
      <div class="step active" id="step1pill"><div class="num">1</div> Choose Doctor</div>
      <div class="step-line" id="line1"></div>
      <div class="step" id="step2pill"><div class="num">2</div> Pick Slot</div>
      <div class="step-line" id="line2"></div>
      <div class="step" id="step3pill"><div class="num">3</div> Confirm</div>
    </div>

    <!-- Filter Row -->
    <div class="filter-row">
      <label><i class="fas fa-filter"></i> Filter:</label>
      <select id="filterHospital" onchange="applyFilters()">
        <option value="">All Hospitals</option>
        <option value="City Hospital">City Hospital</option>
        <option value="Sunrise Medical Center">Sunrise Medical Center</option>
        <option value="Apollo Clinic">Apollo Clinic</option>
      </select>
      <select id="filterDept" onchange="applyFilters()">
        <option value="">All Departments</option>
        <option value="Cardiology">Cardiology</option>
        <option value="Neurology">Neurology</option>
        <option value="Orthopedics">Orthopedics</option>
        <option value="Dermatology">Dermatology</option>
        <option value="Pediatrics">Pediatrics</option>
        <option value="Gynecology">Gynecology</option>
        <option value="General Medicine">General Medicine</option>
        <option value="ENT">ENT</option>
        <option value="Psychiatry">Psychiatry</option>
      </select>
      <input type="date" id="filterDate" onchange="applyFilters()"
        min="<%= new Date().toISOString().split('T')[0] %>"
        value="<%= new Date().toISOString().split('T')[0] %>">
    </div>

    <!-- Doctor Grid -->
    <div class="doctor-grid" id="doctorGrid">
      <!-- Populated via JS from /getDoctorsWithSlots -->
      <div style="grid-column:1/-1;text-align:center;padding:40px;color:#8aa0c0;">
        <i class="fas fa-spinner fa-spin"></i> Loading doctors...
      </div>
    </div>

    <!-- Booking Form — shown after slot selected -->
    <div class="form-panel" id="bookingForm" style="display:none;">
      <h3><i class="fas fa-pen-to-square"></i> Complete Your Booking</h3>

      <div class="selected-summary" id="selectedSummary"></div>

      <form action="/booking" method="POST" id="apptForm">
        <input type="hidden" name="doctor"    id="h_doctor">
        <input type="hidden" name="did"       id="h_did">
        <input type="hidden" name="hospital"  id="h_hospital">
        <input type="hidden" name="department" id="h_department">
        <input type="hidden" name="date"      id="h_date">
        <input type="hidden" name="time"      id="h_time">
        <input type="hidden" name="slotId"    id="h_slotId">

        <div class="form-grid-2">
          <div class="form-row">
            <label>Full Name *</label>
            <input type="text" name="name" value="<%= session.user.name %>" required>
          </div>
          <div class="form-row">
            <label>Email *</label>
            <input type="email" name="email" required>
          </div>
          <div class="form-row">
            <label>Phone *</label>
            <input type="tel" name="phone" placeholder="+91 XXXXX XXXXX" required>
          </div>
          <div class="form-row full">
            <label>Reason for Visit *</label>
            <textarea name="reason" rows="3" placeholder="Briefly describe your symptoms or reason for visit..." required></textarea>
          </div>
        </div>

        <button type="submit" class="btn-submit"><i class="fas fa-check-circle"></i> Confirm Appointment</button>
      </form>

      <% if (msg) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= msg %></div>
      <% } %>
      <% if (errorMsg) { %>
        <div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> <%= errorMsg %></div>
      <% } %>
    </div>

  <% } %>
</main>

<footer id="footer" class="footer">
  <div class="footer-container">
    <div class="footer-section about">
      <h3>Jeevan Raksha</h3>
      <p>Delivering trusted, advanced healthcare since 1995.</p>
      <p class="emergency"><b>Emergency:</b> <span>+91 108 / +91 98765 43210</span></p>
    </div>
    <div class="footer-section"><h4>Quick Links</h4><ul><li><a href="/home">Home</a></li><li><a href="/about">About</a></li><li><a href="/doctors">Doctors</a></li></ul></div>
    <div class="footer-section"><h4>Services</h4><ul><li><a href="/booking">Book Appointment</a></li><li><a href="/lab-tests">Lab Tests</a></li></ul></div>
    <div class="footer-section"><h4>Contact</h4><p>📞 +91 98765 43210</p><p>✉️ contact@jeevanraksha.in</p></div>
  </div>
  <div class="footer-bottom"><p>© 2025 Jeevan Raksha Hospital</p></div>
</footer>

<script>
  // ── Dropdown ──
  const btn = document.getElementById("profileBtn");
  const menu = document.getElementById("dropdownMenu");
  if (btn) { btn.addEventListener("click", e => { e.stopPropagation(); menu.style.display = menu.style.display === "block" ? "none" : "block"; }); }
  document.addEventListener("click", () => { if (menu) menu.style.display = "none"; });

  // ── State ──
  let selectedDoctor = null;  // { name, did, hospital, department, specialization }
  let selectedSlot   = null;  // { _id, startTime, endTime, isBooked }
  let selectedDate   = document.getElementById("filterDate").value;
  let allDoctors     = [];

  // ── Load doctors with their slots ──
  async function loadDoctors() {
    const hospital = document.getElementById("filterHospital").value;
    const dept     = document.getElementById("filterDept").value;
    selectedDate   = document.getElementById("filterDate").value;

    const grid = document.getElementById("doctorGrid");
    grid.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:40px;color:#8aa0c0;"><i class="fas fa-spinner fa-spin"></i> Loading doctors...</div>`;

    try {
      // Fetch all doctors
      let url = "/getDoctorsAll";
      const res = await fetch(url);
      allDoctors = await res.json();

      // Filter client-side
      let filtered = allDoctors;
      if (hospital) filtered = filtered.filter(d => d.hospital === hospital);
      if (dept)     filtered = filtered.filter(d => d.specialization && d.specialization.toLowerCase().includes(dept.toLowerCase()));

      if (!filtered.length) {
        grid.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:40px;color:#8aa0c0;">No doctors found for the selected filters.</div>`;
        return;
      }

      // Fetch slots for each doctor on the selected date
      const slotsMap = {};
      await Promise.all(filtered.map(async doc => {
        try {
          const sr = await fetch(`/getSlots?doctor=${encodeURIComponent(doc.name)}&date=${selectedDate}`);
          slotsMap[doc.did] = await sr.json();
        } catch { slotsMap[doc.did] = []; }
      }));

      renderDoctorGrid(filtered, slotsMap);
    } catch(e) {
      grid.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:40px;color:#f87171;">Failed to load doctors. Please refresh.</div>`;
    }
  }

  function renderDoctorGrid(doctors, slotsMap) {
    const grid = document.getElementById("doctorGrid");
    const icons = { Cardiology:"fa-heart-pulse", Neurology:"fa-brain", Orthopedics:"fa-bone", Dermatology:"fa-spa", Pediatrics:"fa-baby", Gynecology:"fa-venus", "General Medicine":"fa-stethoscope", ENT:"fa-ear-listen", Psychiatry:"fa-head-side-brain", default:"fa-user-md" };

    grid.innerHTML = doctors.map(doc => {
      const slots = slotsMap[doc.did] || [];
      const icon  = icons[doc.specialization] || icons.default;
      const isSelected = selectedDoctor && selectedDoctor.did === doc.did;

      const slotChips = slots.length
        ? slots.map(s => `
            <span class="slot-chip ${s.isBooked ? 'chip-booked' : ''} ${(selectedSlot && selectedSlot._id === s._id) ? 'chip-selected' : ''}"
              data-did="${doc.did}" data-slotid="${s._id}" data-time="${s.startTime}" data-end="${s.endTime}" data-booked="${s.isBooked}"
              onclick="selectSlot(this, '${doc.did}')">
              ${s.startTime}
            </span>`).join('')
        : `<span class="no-slots">No slots on this date</span>`;

      return `
        <div class="doc-card ${isSelected ? 'selected' : ''}" id="card-${doc.did}" onclick="selectDoctor('${doc.did}')">
          <div class="doc-avatar"><i class="fas ${icon}"></i></div>
          <div class="doc-name">Dr. ${doc.name}</div>
          <div class="doc-spec">${doc.specialization}</div>
          <div class="doc-hosp"><i class="fas fa-hospital-alt"></i> ${doc.hospital}</div>
          <div class="slot-chips">${slotChips}</div>
        </div>`;
    }).join('');
  }

  function applyFilters() { loadDoctors(); }

  function selectDoctor(did) {
    const doc = allDoctors.find(d => d.did === did);
    if (!doc) return;
    selectedDoctor = doc;
    // Clear slot selection if doctor changes
    selectedSlot = null;

    document.querySelectorAll(".doc-card").forEach(c => c.classList.remove("selected"));
    const card = document.getElementById("card-" + did);
    if (card) card.classList.add("selected");

    // Advance step 1
    document.getElementById("step1pill").classList.add("done");
    document.getElementById("step2pill").classList.add("active");

    updateFormPanel();
  }

  function selectSlot(el, did) {
    if (el.dataset.booked === "true") return;
    // Select the doctor first
    const doc = allDoctors.find(d => d.did === did);
    if (doc) { selectedDoctor = doc; }

    selectedSlot = { _id: el.dataset.slotid, startTime: el.dataset.time, endTime: el.dataset.end };

    document.querySelectorAll(".slot-chip").forEach(c => c.classList.remove("chip-selected"));
    el.classList.add("chip-selected");
    document.querySelectorAll(".doc-card").forEach(c => c.classList.remove("selected"));
    const card = document.getElementById("card-" + did);
    if (card) card.classList.add("selected");

    // Advance steps
    document.getElementById("step1pill").classList.add("done");
    document.getElementById("step2pill").classList.add("done");
    document.getElementById("line1").classList.add("done");
    document.getElementById("line2").classList.add("done");
    document.getElementById("step3pill").classList.add("active");

    updateFormPanel();
    // Scroll to form
    setTimeout(() => { document.getElementById("bookingForm").scrollIntoView({ behavior: "smooth", block: "start" }); }, 100);
  }

  function updateFormPanel() {
    const panel = document.getElementById("bookingForm");

    if (selectedDoctor && selectedSlot) {
      // Populate hidden fields
      document.getElementById("h_doctor").value     = selectedDoctor.name;
      document.getElementById("h_did").value        = selectedDoctor.did;
      document.getElementById("h_hospital").value   = selectedDoctor.hospital;
      document.getElementById("h_department").value = selectedDoctor.specialization;
      document.getElementById("h_date").value       = selectedDate;
      document.getElementById("h_time").value       = selectedSlot.startTime;
      document.getElementById("h_slotId").value     = selectedSlot._id;

      document.getElementById("selectedSummary").innerHTML = `
        <div class="summary-item">👨‍⚕️ Doctor: <span>Dr. ${selectedDoctor.name}</span></div>
        <div class="summary-item">🏥 Hospital: <span>${selectedDoctor.hospital}</span></div>
        <div class="summary-item">🩺 Dept: <span>${selectedDoctor.specialization}</span></div>
        <div class="summary-item">📅 Date: <span>${selectedDate}</span></div>
        <div class="summary-item">🕐 Slot: <span>${selectedSlot.startTime} – ${selectedSlot.endTime}</span></div>`;

      panel.style.display = "block";
    } else {
      panel.style.display = "none";
    }
  }

</script>

</body>
</html>
