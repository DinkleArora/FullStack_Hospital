
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Jeevan Raksha Queue Health Tracker</title>

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
  <style>
    /* --- ADMIN BOOKINGS PAGE STYLES --- */
    .admin-container {
        padding: 40px 20px;
        max-width: 1300px;
        margin: 0 auto;
    }
    
    h2.page-title {
        color: var(--accent);
        text-align: center;
        margin-bottom: 40px;
        font-size: 2.2em;
        padding-bottom: 10px;
        border-bottom: 2px solid rgba(58, 123, 255, 0.3);
    }
    
    .table-container {
        overflow-x: auto;
        background: var(--card);
        border-radius: 12px;
        border: 1px solid rgba(58, 123, 255, 0.3);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    .booking-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 15px;
        table-layout: fixed;
        min-width: 800px;
    }

    .booking-table th,
    .booking-table td {
        padding: 12px 15px; 
        text-align: left;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        word-wrap: break-word; 
    }
    
    .booking-table th {
        background-color: #1a3461;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    
    /* Column Widths */
    .booking-table thead tr th:nth-child(1) { width: 6%; }
    .booking-table thead tr th:nth-child(2) { width: 17%; }
    .booking-table thead tr th:nth-child(3) { width: 17%; }
    .booking-table thead tr th:nth-child(4) { width: 17%; }
    .booking-table thead tr th:nth-child(5) { width: 18%; }
    .booking-table thead tr th:nth-child(6) { width: 10%; }
    .booking-table thead tr th:nth-child(7) { width: 15%; }
    
    /* Status Badges */
    .status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.85em;
        font-weight: 700;
        text-align: center;
    }
    
    .status-pending { background-color: rgba(255, 193, 7, 0.2); color: var(--pending-color); }
    .status-confirmed { background-color: rgba(40, 167, 69, 0.2); color: var(--confirmed-color); }
    .status-cancelled { background-color: rgba(220, 53, 69, 0.2); color: var(--cancelled-color); }
    
    /* Action Buttons */
    .action-btns a, .action-btns button {
        padding: 6px 10px;
        margin-right: 5px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.9em;
        font-weight: 600;
        text-decoration: none;
        transition: opacity 0.2s;
        color: white;
    }

    .action-btns .btn-view { background-color: #3a7bff; }
    .action-btns .btn-confirm { background-color: #28a745; }
    .action-btns .btn-cancel { background-color: #dc3545; }
    
    .action-btns a:hover, .action-btns button:hover {
        opacity: 0.8;
    }
    
  </style>
</head>

<body>
  <!-- Header -->
  <header class="main-header">
  <div class="logo-section">
    <i class="fas fa-heartbeat logo-icon"></i>
    <h1>Jeevan Raksha</h1>
  </div>
  <nav class="center-nav">
  <a href="/admin">Home</a>
  <a href="/about">About</a>
  <a href="/doctors">Doctors</a>
  <a href="#footer">Contact</a>
</nav>
<div class="nav-right">
  <% if (session && session.user) { %>
    <!-- PROFILE DROPDOWN -->
    <div class="profile-dropdown">
      <button class="profile-btn" id="profileBtn">
        <i class="fa fa-user-circle"></i>
        <span><%= session.user.name %></span>
        <i class="fa fa-caret-down"></i>
      </button>

      <div class="dropdown-menu" id="dropdownMenu">
        <a href="/logout">Logout</a>
      </div>
    </div>

  <% } else { %>
    <a href="/login" class="login-btn">Login</a>
  <% } %>
</div>
</header>
<main class="admin-container">
  <h2 class="page-title">Manage Patient Appointments</h2>

  <div class="table-container">
    <table class="booking-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Patient Name</th>
          <th>Doctor / Specialty</th>
          <th>Hospital</th>
          <th>Date & Time</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
        <% if (bookings && bookings.length > 0) { %>
          <% bookings.forEach(booking => { %>
            <tr>
              <td><%= booking._id.toString().slice(-4) %></td>
              <td><%= booking.name %> (<%= booking.phone %>)</td>
              <td><%= booking.doctor %></td>
              <td><%= booking.hospital %></td>
              <td><%= new Date(booking.date).toLocaleDateString() %> at <%= booking.time %></td>
              <td>
                <% 
                  const status = booking.status || 'Pending';
                  let statusClass = '';
                  switch (status) {
                    case 'Confirmed':
                      statusClass = 'status-confirmed';
                      break;
                    case 'Cancelled':
                      statusClass = 'status-cancelled';
                      break;
                    default:
                      statusClass = 'status-pending';
                  }
                %>
                <span class="status-badge <%= statusClass %>">
                  <%= status %>
                </span>
              </td>

              <td class="action-btns">
                <a href="/admin/view-booking/<%= booking._id %>" class="btn-view">View</a>

                <% if (status === 'Pending') { %>
                  <form action="/admin/confirm-booking/<%= booking._id %>" method="POST" style="display:inline;">
                    <button type="submit" class="btn-confirm">Confirm</button>
                  </form>
                <% } %>

                <% if (status === 'Pending' || status === 'Confirmed') { %>
                  <form action="/admin/cancel-booking/<%= booking._id %>" method="POST" style="display:inline;">
                    <button type="submit" class="btn-cancel">Cancel</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align: center; padding: 30px;">No appointments found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</main>

<!-- Footer Section -->
  <footer id="footer" class="footer">

  <div class="footer-container">

    <!-- About Section -->
    <div class="footer-section about">
      <h3>Jeevan Raksha </h3>
      <p>Delivering trusted, advanced, and compassionate healthcare since 1995.</p>
      <p class="emergency"><b>Emergency Helpline:</b> <span>+91 108 / +91 98765 43210</span></p>
    </div>

    <!-- Quick Links -->
    <div class="footer-section">
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/admin">Home</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/doctors">Doctors</a></li>
        <li><a href="#footer">Contact</a></li>
      </ul>
    </div>

    <!-- Patient Services -->
    <div class="footer-section">
      <h4>Patient Services</h4>
      <ul>
        <li><a href="/admin/manage-bookings">Manage Bookings</a></li>
        <li><a href="/admin/lab-tests">Lab Test</a></li>
        <li><a href="/reports">Upload Reports</a></li>
        <li><a href="/faq">FAQs</a></li>
      </ul>
    </div>

    <!-- Contact Section -->
    <div class="footer-section">
      <h4>Contact Us</h4>
      <p>📍 21, Health Street, Jaipur, Rajasthan, India</p>
      <p>📞 +91 98765 43210</p>
      <p>✉️ contact@jeevanraksha.in</p>
    </div>

    <!-- Social Section -->
    <div class="footer-section">
      <h4>Follow Us</h4>
    <div class="social-icons">
      <a href="#"><i class="fab fa-facebook"></i></a>
      <a href="#"><i class="fab fa-instagram"></i></a>
      <a href="#"><i class="fab fa-twitter"></i></a>
      <a href="#"><i class="fab fa-linkedin"></i></a>
      <a href="#"><i class="fab fa-youtube"></i></a>
    </div>
    </div>

  </div>
  <div class="footer-bottom">
    <p>© 2025 Jeevan Raksha Hospital • Secure | Smart | Live Health Insights</p>
  </div>

</footer>

<script>
// Logic to show/hide profile dropdown
const profileBtn = document.getElementById("profileBtn");
const dropdownMenu = document.getElementById("dropdownMenu");

if (profileBtn) {
  profileBtn.addEventListener("click", function (event) {
    event.stopPropagation();
    dropdownMenu.style.display =
      dropdownMenu.style.display === "block" ? "none" : "block";
  });
}

document.addEventListener("click", function () {
  if (dropdownMenu) dropdownMenu.style.display = "none";
});
</script>
</body>
</html>
