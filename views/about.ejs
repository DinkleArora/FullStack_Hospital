<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>About • Jeevan Raksha Hospital</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
  <style>
    .about-section {
        margin-top: 70px;
        padding: 40px;
        background: #112345;
        color: white;
        border-radius: 12px;
        width: 85%;
        margin-left: auto;
        margin-right: auto;
        border: 1px solid #3a7bff;
    }
    .about-header h1 {
        font-size: 36px;
        margin-bottom: 20px;
        text-align: center;
    }
    .about-content {
        font-size: 18px;
        line-height: 1.7;
        margin-bottom: 30px;
    }
    .about-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 25px;
        margin-top: 30px;
    }
    .about-card {
        background: #0c1b33;
        border: 1px solid #3a7bff;
        padding: 20px;
        border-radius: 10px;
        transition: 0.3s;
    }
    .about-card:hover {
        background: #16325c;
        transform: translateY(-5px);
    }
    .about-card h3 {
        margin-bottom: 10px;
        font-size: 22px;
        color: #3a9bff;
    }
    .about-card p {
        font-size: 16px;
        color: #ddd;
    }
  </style>
</head>

<body>

<!-- Header -->
  <header class="main-header">
  <div class="logo-section">
    <i class="fas fa-heartbeat logo-icon"></i>
    <h1>Jeevan Raksha</h1>
  </div>
  <nav class="center-nav">
  <a href="/home">Home</a>
  <a href="/about">About</a>
  <a href="/doctors">Doctors</a>
  <a href="#footer">Contact</a>
</nav>
<div class="nav-right">
  <% if (session && session.user) { %>
    <!-- PROFILE DROPDOWN -->
    <div class="profile-dropdown">
      <button class="profile-btn" id="profileBtn">
        <i class="fa fa-user-circle"></i>
        <span><%= session.user.name %></span>
        <i class="fa fa-caret-down"></i>
      </button>

      <div class="dropdown-menu" id="dropdownMenu">
        <a href="/logout">Logout</a>
      </div>
    </div>

  <% } else { %>
    <a href="/login" class="login-btn">Login</a>
  <% } %>
</div>
</header>

<!-- ABOUT MAIN SECTION -->
<section class="about-section">
    <div class="about-header">
        <h1>About Jeevan Raksha </h1>
    </div>

    <div class="about-content">
        <p>
            Jeevan Raksha is dedicated to providing reliable, compassionate, and affordable healthcare to
            individuals and families across the region. Our mission is to bring world-class treatment and medical support 
            within everyone's reach.
        </p>

        <p>
            With a team of expert doctors, skilled staff, and modern diagnostic services, we focus on offering accurate care
            and an excellent patient experience.
        </p>
    </div>

    <div class="about-grid">
        <div class="about-card">
            <h3>👩‍⚕️ Expert Doctors</h3>
            <p>
                Our medical team includes highly qualified specialists with years of clinical experience across multiple fields.
            </p>
        </div>

        <div class="about-card">
            <h3>💡 Technology Powered</h3>
            <p>
                Online appointments, lab test listings, digital dashboards, and integrated AI tools enhance patient convenience.
            </p>
        </div>

        <div class="about-card">
            <h3>🔬 Certified Laboratory</h3>
            <p>
                Our NABL-certified lab handles hundreds of diagnostic tests with accuracy and reliability.
            </p>
        </div>

        <div class="about-card">
            <h3>❤️ Patient-Centric Approach</h3>
            <p>
                Compassion, transparency, and empathy form the core of every service we provide to patients and their families.
            </p>
        </div>
    </div>
</section>


<!-- Footer Section -->
  <footer id="footer" class="footer">

  <div class="footer-container">

    <!-- About Section -->
    <div class="footer-section about">
      <h3>Jeevan Raksha </h3>
      <p>Delivering trusted, advanced, and compassionate healthcare since 1995.</p>
      <p class="emergency"><b>Emergency Helpline:</b> <span>+91 108 / +91 98765 43210</span></p>
    </div>

    <!-- Quick Links -->
    <div class="footer-section">
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/home">Home</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/doctors">Doctors</a></li>
        <li><a href="#footer">Contact</a></li>
      </ul>
    </div>

    <!-- Patient Services -->
    <div class="footer-section">
      <h4>Patient Services</h4>
      <ul>
        <li><a href="/booking">Book Appointment</a></li>
        <li><a href="/lab-tests">Lab Test Information</a></li>
        <li><a href="/reports">Download Reports</a></li>
        <li><a href="/faq">FAQs</a></li>
      </ul>
    </div>

    <!-- Contact Section -->
    <div class="footer-section">
      <h4>Contact Us</h4>
      <p>📍 21, Health Street, Jaipur, Rajasthan, India</p>
      <p>📞 +91 98765 43210</p>
      <p>✉️ contact@jeevanraksha.in</p>
    </div>

    <!-- Social Section -->
    <div class="footer-section">
      <h4>Follow Us</h4>
    <div class="social-icons">
      <a href="#"><i class="fab fa-facebook"></i></a>
      <a href="#"><i class="fab fa-instagram"></i></a>
      <a href="#"><i class="fab fa-twitter"></i></a>
      <a href="#"><i class="fab fa-linkedin"></i></a>
      <a href="#"><i class="fab fa-youtube"></i></a>
    </div>
    </div>

  </div>
  <div class="footer-bottom">
    <p>© 2025 Jeevan Raksha Hospital • Secure | Smart | Live Health Insights</p>
  </div>

</footer>
<script>
const btn = document.getElementById("profileBtn");
const menu = document.getElementById("dropdownMenu");

// When the profile button is clicked
if (btn) {
  btn.addEventListener("click", function (event) {
    event.stopPropagation();
    menu.style.display =
      menu.style.display === "block" ? "none" : "block";
  });
}

// Close dropdown when clicking anywhere on screen
document.addEventListener("click", function () {
  if (menu) menu.style.display = "none";
});
</script>
</body>

</html>
