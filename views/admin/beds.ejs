<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Manage Beds – Jeevan Raksha</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    .admin-container { padding: 40px 20px; max-width: 1100px; margin: 0 auto; }
    h2.page-title { color: var(--accent); text-align: center; margin-bottom: 30px; font-size: 2em; border-bottom: 2px solid rgba(58,123,255,0.3); padding-bottom: 10px; }
    .form-card { background: var(--card); border: 1px solid rgba(58,123,255,0.3); border-radius: 12px; padding: 28px; margin-bottom: 36px; }
    .form-card h3 { color: var(--accent); margin-top: 0; }
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; }
    .form-grid input, .form-grid select { background: #0f1724; border: 1px solid rgba(58,123,255,0.3); color: #e6eef6; padding: 10px 12px; border-radius: 8px; font-size: 14px; width: 100%; }
    .btn-add { margin-top: 16px; background: var(--accent); color: white; border: none; padding: 10px 28px; border-radius: 8px; font-size: 14px; cursor: pointer; transition: opacity .2s; }
    .btn-add:hover { opacity: .8; }
    .msg-success { color: #4ade80; background: rgba(74,222,128,.1); padding: 10px 16px; border-radius: 8px; margin-bottom: 16px; }
    .msg-error { color: #f87171; background: rgba(248,113,113,.1); padding: 10px 16px; border-radius: 8px; margin-bottom: 16px; }
    .table-container { overflow-x: auto; background: var(--card); border-radius: 12px; border: 1px solid rgba(58,123,255,0.3); }
    .bed-table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 600px; }
    .bed-table th, .bed-table td { padding: 12px 14px; text-align: left; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .bed-table th { background: #1a3461; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
    .badge-free { background: rgba(74,222,128,.15); color: #4ade80; padding: 3px 10px; border-radius: 20px; font-size: .82em; font-weight: 700; }
    .badge-occ { background: rgba(248,113,113,.15); color: #f87171; padding: 3px 10px; border-radius: 20px; font-size: .82em; font-weight: 700; }
    .action-btns form { display: inline; }
    .btn-assign { background: #3a7bff; color: white; border: none; padding: 5px 10px; border-radius: 5px; cursor: pointer; font-size: .85em; }
    .btn-release { background: #28a745; color: white; border: none; padding: 5px 10px; border-radius: 5px; cursor: pointer; font-size: .85em; }
    .btn-del { background: #dc3545; color: white; border: none; padding: 5px 10px; border-radius: 5px; cursor: pointer; font-size: .85em; }
    .btn-assign:hover, .btn-release:hover, .btn-del:hover { opacity: .8; }
    .inline-input { background: #0f1724; border: 1px solid rgba(58,123,255,.3); color: #e6eef6; padding: 4px 8px; border-radius: 6px; font-size: .85em; width: 110px; }
  </style>
</head>
<body>
  <header class="main-header">
    <div class="logo-section">
      <i class="fas fa-heartbeat logo-icon"></i>
      <h1>Jeevan Raksha</h1>
    </div>
    <nav class="center-nav">
      <a href="/admin">Home</a>
      <a href="/about">About</a>
      <a href="/doctors">Doctors</a>
      <a href="#footer">Contact</a>
    </nav>
    <div class="nav-right">
      <% if (session && session.user) { %>
        <div class="profile-dropdown">
          <button class="profile-btn" id="profileBtn">
            <i class="fa fa-user-circle"></i>
            <span><%= session.user.name %></span>
            <i class="fa fa-caret-down"></i>
          </button>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/logout">Logout</a>
          </div>
        </div>
      <% } else { %>
        <a href="/login" class="login-btn">Login</a>
      <% } %>
    </div>
  </header>

  <main class="admin-container">
    <h2 class="page-title"><i class="fas fa-bed"></i> Manage Beds</h2>

    <% if (msg) { %><div class="msg-success"><%= msg %></div><% } %>
    <% if (errorMsg) { %><div class="msg-error"><%= errorMsg %></div><% } %>

    <!-- Add bed form -->
    <div class="form-card">
      <h3>Add New Bed</h3>
      <form action="/admin/beds/add" method="POST">
        <div class="form-grid">
          <input type="text" name="wardNo" placeholder="Ward No (e.g. W-101)" required />
          <select name="bedType" required>
            <option value="">-- Bed Type --</option>
            <option value="General">General</option>
            <option value="ICU">ICU</option>
            <option value="Private">Private</option>
            <option value="Semi-Private">Semi-Private</option>
          </select>
        </div>
        <button type="submit" class="btn-add"><i class="fas fa-plus"></i> Add Bed</button>
      </form>
    </div>

    <div class="table-container">
      <table class="bed-table">
        <thead>
          <tr>
            <th>Ward No</th>
            <th>Bed Type</th>
            <th>Status</th>
            <th>Assigned Patient</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (beds && beds.length > 0) { %>
            <% beds.forEach(b => { %>
              <tr>
                <td><%= b.wardNo %></td>
                <td><%= b.bedType %></td>
                <td>
                  <% if (!b.isOccupied) { %>
                    <span class="badge-free">Free</span>
                  <% } else { %>
                    <span class="badge-occ">Occupied</span>
                  <% } %>
                </td>
                <td><%= b.patientId || '—' %></td>
                <td class="action-btns">
                  <% if (!b.isOccupied) { %>
                    <form action="/admin/beds/assign/<%= b._id %>" method="POST" style="display:inline;">
                      <input type="text" name="patientId" class="inline-input" placeholder="Patient ID" required />
                      <button type="submit" class="btn-assign">Assign</button>
                    </form>
                  <% } else { %>
                    <form action="/admin/beds/release/<%= b._id %>" method="POST" style="display:inline;">
                      <button type="submit" class="btn-release">Release</button>
                    </form>
                  <% } %>
                  <form action="/admin/beds/delete/<%= b._id %>" method="POST" style="display:inline;">
                    <button type="submit" class="btn-del" onclick="return confirm('Delete this bed?')">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="5" style="text-align:center;padding:24px;">No beds added yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- BED REQUESTS FROM PATIENTS -->
    <div class="form-card" style="margin-top:30px;">
      <h3><i class="fas fa-inbox"></i> Patient Bed Requests</h3>
      <div style="overflow-x:auto;">
        <table class="bed-table">
          <thead>
            <tr>
              <th>Patient ID</th>
              <th>Patient Name</th>
              <th>Phone</th>
              <th>Ward Type</th>
              <th>Preferred Date</th>
              <th>Reason</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (bedRequests && bedRequests.length > 0) { %>
              <% bedRequests.forEach(br => { %>
                <tr>
                  <td><code style="color:#60a5fa;"><%= br.patientId %></code></td>
                  <td><%= br.patientName %></td>
                  <td><%= br.phone %></td>
                  <td><%= br.wardType %></td>
                  <td><%= new Date(br.preferredDate).toLocaleDateString('en-IN') %></td>
                  <td><%= br.reason || '—' %></td>
                  <td>
                    <% if (br.status === 'Pending') { %>
                      <span style="background:rgba(251,191,36,0.15);color:#fbbf24;padding:3px 10px;border-radius:20px;font-size:.8em;font-weight:700;">Pending</span>
                    <% } else if (br.status === 'Approved') { %>
                      <span style="background:rgba(74,222,128,0.15);color:#4ade80;padding:3px 10px;border-radius:20px;font-size:.8em;font-weight:700;">Approved</span>
                    <% } else { %>
                      <span style="background:rgba(248,113,113,0.15);color:#f87171;padding:3px 10px;border-radius:20px;font-size:.8em;font-weight:700;">Rejected</span>
                    <% } %>
                  </td>
                  <td class="action-btns">
                    <% if (br.status === 'Pending') { %>
                      <form action="/admin/bed-requests/approve/<%= br._id %>" method="POST" style="display:inline;">
                        <button type="submit" class="btn-assign">Approve</button>
                      </form>
                      <form action="/admin/bed-requests/reject/<%= br._id %>" method="POST" style="display:inline;">
                        <button type="submit" class="btn-del">Reject</button>
                      </form>
                    <% } else { %>
                      —
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="8" style="text-align:center;padding:20px;color:#8aa0c0;">No bed requests yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <footer id="footer" class="footer">
    <div class="footer-container">
      <div class="footer-section about">
        <h3>Jeevan Raksha</h3>
        <p>Delivering trusted, advanced, and compassionate healthcare since 1995.</p>
        <p class="emergency"><b>Emergency Helpline:</b> <span>+91 108 / +91 98765 43210</span></p>
      </div>
      <div class="footer-section">
        <h4>Admin Tools</h4>
        <ul>
          <li><a href="/admin/manage-bookings">Manage Bookings</a></li>
          <li><a href="/admin/slots">Manage Slots</a></li>
          <li><a href="/admin/beds">Manage Beds</a></li>
          <li><a href="/admin/ambulances">Manage Ambulances</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>Contact Us</h4>
        <p>📍 21, Health Street, Jaipur, Rajasthan, India</p>
        <p>📞 +91 98765 43210</p>
        <p>✉️ contact@jeevanraksha.in</p>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2025 Jeevan Raksha Hospital • Secure | Smart | Live Health Insights</p>
    </div>
  </footer>

  <script>
    const btn = document.getElementById("profileBtn");
    const menu = document.getElementById("dropdownMenu");
    if (btn) btn.addEventListener("click", e => { e.stopPropagation(); menu.style.display = menu.style.display === "block" ? "none" : "block"; });
    document.addEventListener("click", () => { if (menu) menu.style.display = "none"; });
  </script>
</body>
</html>
