<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Book Lab Test – Jeevan Raksha</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    .page-wrap { padding: 44px 24px 60px; max-width: 820px; margin: 0 auto; }
    h2.page-title { color: var(--accent); text-align: center; font-size: 1.8em; margin-bottom: 6px; }
    .page-sub { text-align: center; color: #8aa0c0; margin-bottom: 32px; }

    /* Test info banner */
    .test-banner {
      background: linear-gradient(135deg, rgba(58,123,255,0.12), rgba(0,198,255,0.08));
      border: 1px solid rgba(58,123,255,0.3); border-radius: 14px;
      padding: 22px 26px; display: flex; align-items: center; gap: 20px;
      margin-bottom: 30px; flex-wrap: wrap;
    }
    .test-icon { font-size: 2.4em; color: var(--accent); background: rgba(58,123,255,0.1); width: 60px; height: 60px; border-radius: 14px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .test-info h3 { color: #e6eef6; margin: 0 0 4px 0; font-size: 1.2em; }
    .test-info p  { color: #8aa0c0; margin: 0 0 8px 0; font-size: .88em; }
    .test-price { display: inline-block; background: rgba(74,222,128,0.15); color: #4ade80; font-weight: 700; padding: 4px 14px; border-radius: 20px; font-size: .9em; }
    .test-cat   { display: inline-block; background: rgba(167,139,250,0.15); color: #a78bfa; font-weight: 700; padding: 4px 14px; border-radius: 20px; font-size: .85em; margin-left: 6px; }

    /* Form card */
    .form-card { background: var(--card); border: 1px solid rgba(58,123,255,0.25); border-radius: 16px; padding: 32px; }
    .form-section { margin-bottom: 24px; }
    .section-label { font-size: .95em; font-weight: 700; color: #e6eef6; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
    .section-label i { color: var(--accent); }
    .form-row { margin-bottom: 14px; }
    .form-row label { display: block; margin-bottom: 5px; font-size: .88em; color: #e6eef6; font-weight: 500; }
    .form-row input, .form-row select, .form-row textarea {
      width: 100%; padding: 11px 13px; border-radius: 8px;
      border: 1px solid #334e7a; background: #0f1724; color: #e6eef6;
      font-size: .92em; box-sizing: border-box; transition: border-color .2s;
    }
    .form-row input:focus, .form-row select:focus, .form-row textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px rgba(58,123,255,0.18); }
    .form-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

    /* Hospital cards */
    .hosp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 4px; }
    .hosp-card { padding: 14px 12px; border-radius: 10px; border: 2px solid rgba(58,123,255,0.2); background: #0f1724; cursor: pointer; text-align: center; transition: all .15s; }
    .hosp-card:hover { border-color: var(--accent); }
    .hosp-card.selected { border-color: var(--accent); background: rgba(58,123,255,0.12); }
    .hosp-card i { font-size: 1.5em; color: var(--accent); margin-bottom: 6px; display: block; }
    .hosp-card span { font-size: .78em; color: #e6eef6; font-weight: 600; line-height: 1.3; display: block; }

    /* Slot grid */
    .slot-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 9px; }
    .slot-tile {
      padding: 10px 8px; border-radius: 9px; text-align: center;
      border: 1.5px solid rgba(58,123,255,0.3); background: #0f1724;
      cursor: pointer; transition: all .13s; font-size: .84em; color: #c9d8f0; font-weight: 600;
    }
    .slot-tile:hover:not(.s-booked) { background: var(--accent); border-color: var(--accent); color: white; }
    .slot-tile.s-selected { background: var(--accent); border-color: var(--accent); color: white; box-shadow: 0 0 10px rgba(58,123,255,0.45); }
    .slot-tile.s-booked { opacity: .38; cursor: not-allowed; text-decoration: line-through; }
    .slot-tile .slot-icon { font-size: .75em; color: rgba(255,255,255,0.6); margin-bottom: 2px; }
    .slot-hint { font-size: .78em; color: #8aa0c0; margin-top: 8px; font-style: italic; }

    /* Selected slot confirmation */
    .slot-confirm { background: rgba(58,123,255,0.08); border: 1px solid rgba(58,123,255,0.25); border-radius: 8px; padding: 10px 14px; margin-top: 10px; font-size: .88em; color: #e6eef6; display: none; }
    .slot-confirm.visible { display: block; }

    .divider { border: none; border-top: 1px solid rgba(58,123,255,0.15); margin: 20px 0; }

    .btn-submit { background: var(--accent); padding: 13px; border: none; color: white; border-radius: 8px; width: 100%; cursor: pointer; font-size: 1em; font-weight: 700; margin-top: 6px; transition: background .2s; }
    .btn-submit:hover { background: #2a68e6; }
    .alert { padding: 13px 16px; border-radius: 8px; margin-top: 16px; font-weight: 500; }
    .alert-success { background: rgba(74,222,128,0.1); color: #4ade80; border: 1px solid rgba(74,222,128,0.3); }
    .alert-danger  { background: rgba(248,113,113,0.1); color: #f87171; border: 1px solid rgba(248,113,113,0.3); }

    @media(max-width:600px){ .hosp-grid{ grid-template-columns: 1fr 1fr; } .form-2col{ grid-template-columns:1fr; } }
  </style>
</head>
<body>

<header class="main-header">
  <div class="logo-section">
    <i class="fas fa-heartbeat logo-icon"></i>
    <h1>Jeevan Raksha</h1>
  </div>
  <nav class="center-nav">
    <a href="/home">Home</a>
    <a href="/about">About</a>
    <a href="/doctors">Doctors</a>
    <a href="#footer">Contact</a>
  </nav>
  <div class="nav-right">
    <% if (session && session.user) { %>
      <div class="profile-dropdown">
        <button class="profile-btn" id="profileBtn">
          <i class="fa fa-user-circle"></i>
          <span><%= session.user.name %></span>
          <i class="fa fa-caret-down"></i>
        </button>
        <div class="dropdown-menu" id="dropdownMenu">
          <% if (session.user.role === 'patient') { %><a href="/patient/dashboard">My Dashboard</a><% } %>
          <a href="/logout">Logout</a>
        </div>
      </div>
    <% } else { %>
      <a href="/login" class="login-btn">Login</a>
    <% } %>
  </div>
</header>

<main class="page-wrap">
  <h2 class="page-title"><i class="fas fa-flask"></i> Book Lab Test</h2>
  <p class="page-sub">Select a hospital, date, and your preferred time slot</p>

  <!-- Test info banner -->
  <div class="test-banner">
    <div class="test-icon"><i class="fas fa-vial"></i></div>
    <div class="test-info">
      <h3><%= test.name %></h3>
      <p><%= test.description || 'Diagnostic lab test at your preferred hospital and time.' %></p>
      <span class="test-price">₹<%= test.price %></span>
      <span class="test-cat"><%= test.category %></span>
    </div>
  </div>

  <% if (msg) { %>
    <div class="alert alert-success" style="margin-bottom:20px;"><i class="fas fa-check-circle"></i> <%= msg %></div>
  <% } %>
  <% if (errorMsg) { %>
    <div class="alert alert-danger" style="margin-bottom:20px;"><i class="fas fa-exclamation-circle"></i> <%= errorMsg %></div>
  <% } %>

  <div class="form-card">
    <form action="/lab-tests/book/<%= test._id %>" method="POST" id="labForm">
      <!-- Patient Details -->
      <div class="form-section">
        <div class="section-label"><i class="fas fa-user"></i> Patient Details</div>
        <div class="form-2col">
          <div class="form-row">
            <label>Full Name *</label>
            <input type="text" name="patientName" value="<%= session && session.user ? session.user.name : '' %>" required>
          </div>
          <div class="form-row">
            <label>Email *</label>
            <input type="email" name="email" required>
          </div>
          <div class="form-row">
            <label>Phone *</label>
            <input type="tel" name="phone" placeholder="+91 XXXXX XXXXX" required>
          </div>
        </div>
      </div>

      <hr class="divider">

      <!-- Hospital Selection -->
      <div class="form-section">
        <div class="section-label"><i class="fas fa-hospital-alt"></i> Choose Hospital *</div>
        <div class="hosp-grid">
          <div class="hosp-card" onclick="selectHospital('City Hospital', this)">
            <i class="fas fa-building-columns"></i>
            <span>City Hospital</span>
          </div>
          <div class="hosp-card" onclick="selectHospital('Sunrise Medical Center', this)">
            <i class="fas fa-sun"></i>
            <span>Sunrise Medical Center</span>
          </div>
          <div class="hosp-card" onclick="selectHospital('Apollo Clinic', this)">
            <i class="fas fa-clinic-medical"></i>
            <span>Apollo Clinic</span>
          </div>
        </div>
        <input type="hidden" name="hospital" id="hospitalInput" required>
      </div>

      <hr class="divider">

      <!-- Date Selection -->
      <div class="form-section">
        <div class="section-label"><i class="fas fa-calendar"></i> Choose Date *</div>
        <div class="form-row" style="max-width:260px;">
          <input type="date" name="date" id="labDate" required
            min="<%= new Date().toISOString().split('T')[0] %>"
            onchange="renderLabSlots()">
        </div>
      </div>

      <hr class="divider">

      <!-- Time Slot Grid -->
      <div class="form-section">
        <div class="section-label"><i class="fas fa-clock"></i> Select Time Slot *</div>
        <div class="slot-grid" id="labSlotGrid">
          <!-- Pre-rendered fixed lab slots -->
          <div class="slot-tile" onclick="selectLabSlot(this, '07:00')"><div class="slot-icon"><i class="fas fa-sun"></i></div>07:00 AM</div>
          <div class="slot-tile" onclick="selectLabSlot(this, '08:00')"><div class="slot-icon"><i class="fas fa-sun"></i></div>08:00 AM</div>
          <div class="slot-tile" onclick="selectLabSlot(this, '09:00')"><div class="slot-icon"><i class="fas fa-sun"></i></div>09:00 AM</div>
          <div class="slot-tile" onclick="selectLabSlot(this, '10:00')"><div class="slot-icon"><i class="fas fa-sun"></i></div>10:00 AM</div>
          <div class="slot-tile" onclick="selectLabSlot(this, '11:00')"><div class="slot-icon"><i class="fas fa-mug-hot"></i></div>11:00 AM</div>
          <div class="slot-tile" onclick="selectLabSlot(this, '12:00')"><div class="slot-icon"><i class="fas fa-cloud-sun"></i></div>12:00 PM</div>
          <div class="slot-tile" onclick="selectLabSlot(this, '14:00')"><div class="slot-icon"><i class="fas fa-cloud-sun"></i></div>02:00 PM</div>
          <div class="slot-tile" onclick="selectLabSlot(this, '15:00')"><div class="slot-icon"><i class="fas fa-cloud"></i></div>03:00 PM</div>
          <div class="slot-tile" onclick="selectLabSlot(this, '16:00')"><div class="slot-icon"><i class="fas fa-cloud"></i></div>04:00 PM</div>
          <div class="slot-tile" onclick="selectLabSlot(this, '17:00')"><div class="slot-icon"><i class="fas fa-cloud-moon"></i></div>05:00 PM</div>
          <div class="slot-tile" onclick="selectLabSlot(this, '18:00')"><div class="slot-icon"><i class="fas fa-moon"></i></div>06:00 PM</div>
          <div class="slot-tile" onclick="selectLabSlot(this, '19:00')"><div class="slot-icon"><i class="fas fa-moon"></i></div>07:00 PM</div>
        </div>
        <p class="slot-hint">* Some slots may be unavailable on Sundays and public holidays</p>
        <div class="slot-confirm" id="slotConfirm">✅ Selected slot: <strong id="slotConfirmText"></strong></div>
        <input type="hidden" name="time" id="labTimeInput" required>
      </div>

      <hr class="divider">

      <!-- Notes -->
      <div class="form-section">
        <div class="section-label"><i class="fas fa-notes-medical"></i> Additional Notes</div>
        <textarea name="message" rows="3" placeholder="Any special instructions, fasting requirements query, or symptoms to mention..."></textarea>
      </div>

      <button type="submit" class="btn-submit" id="labSubmitBtn"><i class="fas fa-check-circle"></i> Confirm Lab Test Booking</button>
    </form>
  </div>
</main>

<footer id="footer" class="footer">
  <div class="footer-container">
    <div class="footer-section about"><h3>Jeevan Raksha</h3><p>Delivering trusted, advanced healthcare since 1995.</p><p class="emergency"><b>Emergency:</b> <span>+91 108</span></p></div>
    <div class="footer-section"><h4>Quick Links</h4><ul><li><a href="/home">Home</a></li><li><a href="/lab-tests">Lab Tests</a></li></ul></div>
    <div class="footer-section"><h4>Contact</h4><p>📞 +91 98765 43210</p><p>✉️ contact@jeevanraksha.in</p></div>
  </div>
  <div class="footer-bottom"><p>© 2025 Jeevan Raksha Hospital</p></div>
</footer>

<script>
  const btn = document.getElementById("profileBtn");
  const menu = document.getElementById("dropdownMenu");
  if (btn) { btn.addEventListener("click", e => { e.stopPropagation(); menu.style.display = menu.style.display === "block" ? "none" : "block"; }); }
  document.addEventListener("click", () => { if (menu) menu.style.display = "none"; });

  function selectHospital(name, el) {
    document.querySelectorAll(".hosp-card").forEach(c => c.classList.remove("selected"));
    el.classList.add("selected");
    document.getElementById("hospitalInput").value = name;
    renderLabSlots();
  }

  function selectLabSlot(el, time) {
    if (el.classList.contains("s-booked")) return;
    document.querySelectorAll(".slot-tile").forEach(t => t.classList.remove("s-selected"));
    el.classList.add("s-selected");
    document.getElementById("labTimeInput").value = time;
    const confirm = document.getElementById("slotConfirm");
    document.getElementById("slotConfirmText").textContent = el.textContent.trim();
    confirm.classList.add("visible");
  }

  async function renderLabSlots() {
    const date = document.getElementById("labDate").value;
    const hospital = document.getElementById("hospitalInput").value;
    if (!date) return;

    // On Sundays (0), grey out afternoon slots
    const day = new Date(date).getDay();
    const allTiles = document.querySelectorAll(".slot-tile");
    allTiles.forEach(t => {
      t.classList.remove("s-booked");
      // Sunday: only morning slots available
      if (day === 0) {
        const time = t.getAttribute("onclick").match(/'(\d+:\d+)'/)?.[1];
        if (time && parseInt(time) >= 12) t.classList.add("s-booked");
      }
    });
  }

  // Validate on submit
  document.getElementById("labForm").addEventListener("submit", function(e) {
    if (!document.getElementById("hospitalInput").value) { e.preventDefault(); alert("Please select a hospital."); return; }
    if (!document.getElementById("labTimeInput").value)  { e.preventDefault(); alert("Please select a time slot."); return; }
  });
</script>
</body>
</html>
